# ════════════════════════════════════════
#   CHỈ CẦN ĐIỀN 2 KEY NÀY LÀ HỆ THỐNG CHẠY
# ════════════════════════════════════════

# --- STRIPE ---
# Lấy tại: dashboard.stripe.com → Developers → API Keys → Secret key
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_KEY

# Webhook secret: chạy `stripe listen --forward-to localhost:3001/api/webhooks/stripe`
# rồi copy secret từ terminal (bắt đầu bằng whsec_...)
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_YOUR_WEBHOOK_SECRET

# --- MOMO ---
# Lấy tại: business.momo.vn → Tích hợp → Thông tin kết nối → secretKey
MOMO_SECRET_KEY=REPLACE_WITH_YOUR_MOMO_SECRET_KEY

# ════════════════════════════════════════
#   CẤU HÌNH MẶC ĐỊNH (SANDBOX — không cần đổi khi dev)
