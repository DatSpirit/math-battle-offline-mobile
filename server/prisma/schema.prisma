// Prisma Schema — Math Battle Backend
// Order model (payment) + User model (auth/pvp)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// ─── PAYMENT (giữ nguyên) ──────────────────────────
model Order {
  id              String   @id @default(cuid())
  orderId         String   @unique
  userId          String
  itemId          String
  amountUsd       Float
  amountLocal     Int
  currency        String
  paymentMethod   String
  status          String   @default("PENDING")
  intentId        String?
  transId         String?
  rewardDelivered Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ─── USER & PROFILE (Sprint 1) ─────────────────────
model User {
  id            String   @id @default(cuid())
  supabaseId    String?  @unique
  username      String   @unique
  avatarEmoji   String   @default("🐼")
  level         Int      @default(1)
  xp            Int      @default(0)
  elo           Int      @default(1000)
  coins         Int      @default(10000)
  gems          Int      @default(50)
  wins          Int      @default(0)
  winStreak     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ─── PVP ROOM (Sprint 4–5) ─────────────────────────
model PvpRoom {
  id          String   @id @default(cuid())
  roomCode    String   @unique
  status      String   @default("waiting") // waiting | playing | finished
  p1Id        String?  // supabaseId
  p2Id        String?
  p1Score     Int      @default(0)
  p2Score     Int      @default(0)
  currentTurn Int      @default(0)
  winnerId    String?
  p1Elo       Int      @default(0)
  p2Elo       Int      @default(0)
  p1EloChange Int      @default(0)
  p2EloChange Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
